program ueb10_korrigiert;

{$APPTYPE CONSOLE}
{$R+,Q+,X-}

uses
  System.SysUtils;

//Datentypen und globale Variable
var
  g_Speicherzaehler: Integer = 0;
type
  TLeistung = record
    Nummer: string[5];
    Note: Real;
  end;
  PLeistungNode = ^TLeistungNode;
  TLeistungNode = record
    Data: TLeistung;
    Next: PLeistungNode;
  end;
  TModulSP = record
    Nummer: string[5];
    ECTS: Byte;
  end;
  PModulSPNode = ^TModulSPNode;
  TModulSPNode = record
    Data: TModulSP;
    Next: PModulSPNode;
  end;

//Speicherverwaltung
procedure GibLeistungslisteFrei(var Kopf: PLeistungNode);
var
  Aktuell: PLeistungNode;
begin
  while Kopf <> nil do
  begin
    Aktuell := Kopf;
    Kopf := Kopf^.Next;
    Dispose(Aktuell);
    Dec(g_Speicherzaehler);
  end;
end;
procedure GibModulSPListeFrei(var Kopf: PModulSPNode);
var
  Aktuell: PModulSPNode;
begin
  while Kopf <> nil do
  begin
    Aktuell := Kopf;
    Kopf := Kopf^.Next;
    Dispose(Aktuell);
    Dec(g_Speicherzaehler);
  end;
end;


// Datei-Routinen
function LeseStudentenDatei(const Dateiname: string; out Name, Fachrichtung: string; out Leistungsliste: PLeistungNode): Boolean;
var
  F: TextFile;
  Zeile, NotenStr, ModulNr: string;
  DoppelpunktPos: Integer;
  Note: Real;
  NeuerKnoten: PLeistungNode;
begin
  Leistungsliste := nil;
  LeseStudentenDatei := False; // Standardmäßig von einem Fehler ausgehen

  if FileExists(Dateiname) then
  begin
    AssignFile(F, Dateiname);
    try
      Reset(F);
      if not Eof(F) then Readln(F, Name) else raise Exception.Create('Datei ist leer.');
      if not Eof(F) then Readln(F, Fachrichtung) else raise Exception.Create('Fachrichtung fehlt.');
      while not Eof(F) do
      begin
        Readln(F, Zeile);
        DoppelpunktPos := Pos(':', Zeile);
        if DoppelpunktPos > 0 then
        begin
          ModulNr := Copy(Zeile, 1, DoppelpunktPos - 1);
          NotenStr := Copy(Zeile, DoppelpunktPos + 1, Length(Zeile));
          if TryStrToFloat(NotenStr, Note) then
          begin
            New(NeuerKnoten); Inc(g_Speicherzaehler);
            NeuerKnoten^.Data.Nummer := ModulNr;
            NeuerKnoten^.Data.Note := Note;
            NeuerKnoten^.Next := Leistungsliste;
            Leistungsliste := NeuerKnoten;
          end else raise Exception.Create('Ungültige Note in Zeile: ' + Zeile);
        end else raise Exception.Create('Ungültiges Format in Zeile: ' + Zeile);
      end;
      LeseStudentenDatei := True; // Erfolgreich
    except
      on E: Exception do Writeln('FEHLER beim Lesen der Studentendatei: ', E.Message);
    finally
      CloseFile(F);
    end;
  end else Writeln('FEHLER: Die Datei "', Dateiname, '" wurde nicht gefunden.');
end;

function LeseStudiengangDatei(const Fachrichtung: string; out ModulListe: PModulSPNode): Boolean;
var
  F: file of TModulSP;
  Dateiname: string;
  EinModul: TModulSP;
  NeuerKnoten: PModulSPNode;
begin
  ModulListe := nil;
  LeseStudiengangDatei := False;
  Dateiname := ExtractFilePath(ParamStr(0)) + Fachrichtung + '.sp';

  if FileExists(Dateiname) then
  begin
    AssignFile(F, Dateiname);
    try
      Reset(F);
      while not Eof(F) do
      begin
        Read(F, EinModul);
        New(NeuerKnoten); Inc(g_Speicherzaehler);
        NeuerKnoten^.Data := EinModul;
        NeuerKnoten^.Next := ModulListe;
        ModulListe := NeuerKnoten;
      end;
      LeseStudiengangDatei := True;
    except
      on E: Exception do Writeln('FEHLER beim Lesen der Studiengangsdatei: ', E.Message);
    finally
      CloseFile(F);
    end;
  end else Writeln('FEHLER: Die Studiengangsdatei "', Dateiname, '" wurde nicht gefunden.');
end;


//main

var
  StudentenDatei, StudentenName, StudentenFachrichtung: string;
  KopfLeistungen: PLeistungNode = nil;
  KopfModule: PModulSPNode = nil;
  AnzahlBestanden, AnzahlGesamt: Integer;
  Fortschritt: Real;
  AktLeistung: PLeistungNode;
begin
  Writeln('--- Programm zur Studienleistungsprüfung ---');
  Write('Bitte geben Sie den Dateinamen des Studenten ein (z.B. Student1.txt): ');
  Readln(StudentenDatei);

  try
    // Aufruf der Funktion. Das Ergebnis wird direkt in der if-Bedingung verwendet.
    if LeseStudentenDatei(ExtractFilePath(ParamStr(0)) + StudentenDatei, StudentenName, StudentenFachrichtung, KopfLeistungen) then
    begin
      Writeln('INFO: Studentendatei erfolgreich gelesen. Name: ', StudentenName, ', Fachrichtung: ', StudentenFachrichtung);

      if LeseStudiengangDatei(StudentenFachrichtung, KopfModule) then
      begin
        Writeln('INFO: Studiengangsdatei erfolgreich gelesen.');
        //Komplette Auswertung hier
      end;
    end;
  finally
    Writeln('INFO: Räume Speicher auf...');
    GibLeistungslisteFrei(KopfLeistungen);
    GibModulSPListeFrei(KopfModule);
    if g_Speicherzaehler = 0 then
      Writeln('INFO: Speicherprüfung erfolgreich.')
    else
      Writeln('ACHTUNG: Speicherleck entdeckt! Zähler steht auf: ', g_Speicherzaehler);
  end;

  Writeln('Programmende. Drücken Sie Enter.');
  Readln;
end.
